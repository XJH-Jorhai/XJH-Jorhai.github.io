---
// 首屏：TEISU 标志。载入时拼合；下滑时「解锁」——中心方块转动，整枚标志旋转 180°（中心对称，转完仍是原形），
// 随后四角向画面四角退开成取景框，两片红刃沿斜线滑出，中心让出一句话。
import brand from '../../data/brand.json';
const order = ['tl','br','tr','bl','ru','rl','c'] as const;
---
<section class="hero hero-unlock" data-unlock aria-labelledby="hero-title">
  <div class="unlock-stage">
    <h1 id="hero-title" class="visually-hidden">TEISU · FIELDNOTES 个人博客</h1>
    <div class="unlock-mark" aria-hidden="true">
      {order.map(key => <svg class={`piece piece-${key}`} viewBox="0 0 720 720"><path d={brand.pieces[key]} fill={key.startsWith('r') ? brand.colors.red : brand.colors.navy} /></svg>)}
    </div>
    <div class="unlock-lockup">
      <svg class="unlock-word" viewBox="190 1250 1620 384" aria-hidden="true"><g fill={brand.colors.navy} set:html={brand.word} /><g fill={brand.colors.red} set:html={brand.redbar} /></svg>
      <p class="unlock-name"><span class="rule" aria-hidden="true"></span><span>FIELDNOTES</span><span class="rule" aria-hidden="true"></span></p>
      <p class="unlock-sub">研究<i aria-hidden="true">·</i>制作<i aria-hidden="true">·</i>观察</p>
    </div>
    <p class="unlock-message">把想法做成实物，<br />也把过程留在这里。</p>
    <a class="unlock-hint" href="#intro"><span class="unlock-hint-text">Scroll to unlock</span><span class="unlock-track" aria-hidden="true"><span></span></span></a>
  </div>
</section>
