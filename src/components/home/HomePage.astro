---
import PageShell from '../PageShell.astro';
import WorkGallery from '../WorkGallery.astro';
import NoteList from '../NoteList.astro';
import PistonGolem from '../PistonGolem.astro';
import Gate from './Gate.astro';
import Wordmark from './Wordmark.astro';
import StrokeWord from './StrokeWord.astro';
import { journal, journalNotes } from '../../data/journal';
import { persona } from '../../data/persona';
import '@fontsource/barlow-condensed/900-italic.css';
import { getCollection } from 'astro:content';
import '../../styles/home.css';
const workCount = (await getCollection('projects')).length;
const pad = (n: number) => String(n).padStart(2, '0');
---
<PageShell title="Blog" description={journal.description} sheen home>
  <Gate slot="overlay" />
  <div class="home" data-home>
    <section class="hero page" id="cover" data-page tabindex="-1" aria-labelledby="hero-title">
      <div class="hero-grid">
        <h1 id="hero-title" class="hero-title"><span class="visually-hidden">FIELDNOTES</span><StrokeWord text="FIELD" id="a" /><StrokeWord text="NOTES" id="b" delay={.2} /></h1>
        <div class="hero-imprint">
          <p class="h-no" data-h style="--d:.5s">Issued by</p>
          <div data-h style="--d:.58s"><Wordmark uid="hero" /></div>
          <p class="hero-lede stair">{journal.lede.map((line, i) => <span data-h style={`--step:${i};--d:${(.68 + i * .08).toFixed(2)}s`}>{line}</span>)}</p>
        </div>
        <p class="hero-byline" data-h style="--d:.7s"><span class="h-no">Kept by</span><span class="hero-handle">{journal.author}</span></p>
        <p class="hero-line"><span class="hero-line-flat" data-h style="--d:.8s">{journal.introduction}</span>{journal.motto.map((column, c) => <span class="hero-col" aria-hidden="true">{[...column].map((char, i) => <i style={`--c:${c * 8 + i}`}>{char}</i>)}</span>)}</p>
        <div class="hero-foot">
          <p class="h-no" data-h style="--d:.95s">研究 · 制作 · 观察</p>
          <nav class="hero-index stair" aria-label="本页内容">
            <a href="#work" data-h style="--step:0;--d:1s"><span>(01)</span>Work</a>
            <a href="#notes" data-h style="--step:1;--d:1.08s"><span>(02)</span>Notes</a>
            <a href="#about" data-h style="--step:2;--d:1.16s"><span>(03)</span>About</a>
          </nav>
        </div>
      </div>
    </section>

    <section class="h-work page" id="work" data-page tabindex="-1" aria-labelledby="work-heading">
      <p class="page-edge" aria-hidden="true">(01) Selected work <i>/</i> Fieldnotes <i>/</i> Teisu</p>
      <div class="page-width">
        <header class="h-head">
          <p class="h-no" data-enter style="--k:0">(01)</p>
          <h2 id="work-heading" data-enter="cut" style="--k:1">Selected Work</h2>
          <p class="h-meta stair" data-enter style="--k:3"><span style="--step:1">{pad(workCount)} projects</span><a href="/work/" style="--step:0">全部作品 <span aria-hidden="true">↗</span></a></p>
        </header>
        <WorkGallery variant="poster" />
      </div>
    </section>

    <section class="h-notes night-band tone-night page" id="notes" data-page tabindex="-1" aria-labelledby="notes-heading">
      <p class="page-edge" aria-hidden="true">(02) Notes &amp; observations <i>/</i> Fieldnotes <i>/</i> Teisu</p>
      <div class="page-width">
        <header class="h-head">
          <p class="h-no" data-enter style="--k:0">(02)</p>
          <h2 id="notes-heading"><span data-enter="cut" style="--k:1">Notes &amp;</span><span data-enter="cut" style="--k:2.4">Observations</span></h2>
          <p class="h-meta stair" data-enter style="--k:3"><span style="--step:1">{pad(journalNotes.length)} drafts</span><a href="/notes/" style="--step:0">全部记录 <span aria-hidden="true">↗</span></a></p>
        </header>
        <NoteList limit={3} />
      </div>
    </section>

    <!-- (03) Persona & About, one page. The character stands across the navy slab's diagonal; About's text
         is on the paper to her left, the claim and the colophon on the navy to her right. PERSONA is set
         twice (navy on paper, paper-white clipped to the slab) so it changes colour where it crosses.
         On a fine pointer the layers move at different depths, she turns a little and her eyes follow the
         pointer (persona-stage.ts). -->
    <section class="h-persona page" id="about" data-alias="persona" data-page tabindex="-1" aria-labelledby="about-heading">
      <div class="hp-stage" data-hp-stage>
        <div class="hp-ground" aria-hidden="true"><i class="hp-slab"></i><i class="hp-blade"></i></div>
        <p class="hp-word" aria-hidden="true">{['hp-ink', 'hp-cut'].map(layer => <span class:list={['hp-word-layer', layer]}>{[...'PERSONA'].map((char, i) => <span class="hp-letter" style={`--i:${i}`}>{char}</span>)}</span>)}</p>
        <div class="hp-figure-box">
          <span class="hp-shadow" aria-hidden="true" style={`--mask:url(${persona.figure.src})`}></span>
          <div class="hp-figure-body">
            <img class="hp-figure" src={persona.figure.src} width={persona.figure.width} height={persona.figure.height} alt={persona.figureAlt} loading="eager" decoding="async" />
            {persona.eyes.map(eye => <span class="hp-eye" aria-hidden="true" data-hp-eye data-white={eye.white} data-iris={eye.iris} style={eye.style}></span>)}
          </div>
        </div>
        <div class="hp-side tone-night">
          <p class="hp-claim" data-enter="right" style="--k:6">{persona.claim.en.map(line => <span>{line}</span>)}<small>{persona.claim.zh}</small></p>
          <dl class="hp-colophon">
            <div data-enter="right" style="--k:7"><dt>Issued by</dt><dd>TEISU<span>假想组织</span></dd></div>
            <div data-enter="right" style="--k:8"><dt>Kept by</dt><dd>{journal.author}</dd></div>
          </dl>
          <a class="hp-link" href="/persona/" data-enter style="--k:9"><span class="hp-link-zh">人物设定</span><span class="hp-link-en">View persona</span><span class="hp-link-arrow" aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="hp-about">
        <p class="hp-tag h-no" data-enter style="--k:0"><span>(03)</span><span>About</span><span>Persona</span></p>
        <h2 id="about-heading"><span data-enter="cut" style="--k:1">保持好奇，</span><span data-enter="cut" style="--k:2.4">慢慢做。</span></h2>
        <p class="hp-about-text" data-lines style="--k:4">{journal.about}</p>
        <p class="hp-about-note" data-lines style="--k:6">这个空间会随着项目一起生长。介绍文字为初稿，笔记目录暂为写作提纲占位，之后逐步换成真实的过程与记录。</p>
        <a class="hp-about-link" href="/notes/" data-enter style="--k:8">从一则笔记开始 <span aria-hidden="true">↗</span></a>
      </div>
      <p class="page-edge" aria-hidden="true">(03) About <i>/</i> Persona <i>/</i> Teisu</p>
    </section>

    <section class="h-outro page" id="end" data-page tabindex="-1" aria-label="站点导航">
      <p class="page-edge" aria-hidden="true">(04) Index <i>/</i> Fieldnotes <i>/</i> Teisu</p>
      <div class="page-width">
        <div class="h-outro-row">
          <div class="h-outro-object" data-enter="fade" style="--k:1"><PistonGolem /></div>
          <ul class="h-outro-links stair">
            <li data-enter="right" style="--k:1;--step:3"><a href="/work/">Work <span aria-hidden="true">↗</span></a></li>
            <li data-enter="right" style="--k:2;--step:2"><a href="/notes/">Notes <span aria-hidden="true">↗</span></a></li>
            <li data-enter="right" style="--k:3;--step:1"><a href="/persona/">Persona <span aria-hidden="true">↗</span></a></li>
            <li data-enter="right" style="--k:4;--step:0"><a href="https://github.com/XJH-Jorhai">GitHub <span aria-hidden="true">↗</span></a></li>
          </ul>
        </div>
        <p class="h-outro-sign h-no"><span data-enter style="--k:4">Fieldnotes</span><span data-enter style="--k:5">Issued by Teisu</span><span data-enter style="--k:6">Kept by {journal.author}</span></p>
        <div class="h-outro-mark" data-enter="cut" style="--k:4"><Wordmark uid="outro" /></div>
      </div>
    </section>
  </div>
  <!-- Paged home (pager.ts): a tick per page, and the canvas the page transition is drawn on (sweep.ts). -->
  <nav class="pager" data-pager aria-label="分屏导航" hidden>
    <a href="#cover"><span>Cover</span></a>
    <a href="#work"><span>Work</span></a>
    <a href="#notes"><span>Notes</span></a>
    <a href="#about"><span>About</span></a>
    <a href="#end"><span>Index</span></a>
  </nav>
  <canvas class="wipe" data-wipe aria-hidden="true"></canvas>
  <script>
    import { initGate } from '../../lib/motion/gate';
    import { initPager } from '../../lib/motion/pager';
    import { initPersonaStage } from '../../lib/motion/persona-stage';
    initPersonaStage();
    initPager();
    initGate();
  </script>
</PageShell>
