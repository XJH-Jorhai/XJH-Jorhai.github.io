---
import PageShell from '../PageShell.astro';
import WorkGallery from '../WorkGallery.astro';
import NoteList from '../NoteList.astro';
import PistonGolem from '../PistonGolem.astro';
import Gate from './Gate.astro';
import Wordmark from './Wordmark.astro';
import { journal, journalNotes } from '../../data/journal';
import { getCollection } from 'astro:content';
import '../../styles/home.css';
const workCount = (await getCollection('projects')).length;
const pad = (n: number) => String(n).padStart(2, '0');
---
<PageShell title="Blog" description={journal.description} sheen home>
  <Gate slot="overlay" />
  <div class="home" data-home>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-grid">
        <h1 id="hero-title" class="hero-title" aria-label="FIELDNOTES"><span class="hero-word hero-word--a" aria-hidden="true">{[...'FIELD'].map((c, i) => <span class="hl" style={`--i:${i}`}>{c}</span>)}</span><span class="hero-word hero-word--b" aria-hidden="true">{[...'NOTES'].map((c, i) => <span class="hl" style={`--i:${i}`}>{c}</span>)}</span></h1>
        <div class="hero-imprint" data-h style="--d:.5s">
          <p class="h-no">Issued by</p>
          <Wordmark uid="hero" />
          <p class="hero-lede">{journal.description}</p>
        </div>
        <div class="hero-byline" data-h style="--d:.62s">
          <p class="h-no">Kept by</p>
          <p class="hero-handle">{journal.author}</p>
        </div>
        <div class="hero-foot" data-h style="--d:.74s">
          <p class="hero-line">{journal.introduction}</p>
          <nav class="hero-index" aria-label="本页内容">
            <a href="#work"><span>(01)</span>Work</a>
            <a href="#notes"><span>(02)</span>Notes</a>
            <a href="#about"><span>(03)</span>About</a>
          </nav>
        </div>
      </div>
    </section>

    <section class="h-work page-width" id="work" aria-labelledby="work-heading">
      <header class="h-head">
        <p class="h-no" data-reveal>(01)</p>
        <h2 id="work-heading" data-reveal="lines"><span class="line"><span>Selected<br />Work</span></span></h2>
        <p class="h-meta" data-reveal><span>{pad(workCount)} projects</span><a href="/work/">全部作品 <span aria-hidden="true">↗</span></a></p>
      </header>
      <WorkGallery variant="poster" />
    </section>

    <section class="h-notes night-band tone-night" id="notes" aria-labelledby="notes-heading">
      <div class="page-width">
        <header class="h-head">
          <p class="h-no" data-reveal>(02)</p>
          <h2 id="notes-heading" data-reveal="lines"><span class="line"><span>Notes &amp;<br />Observations</span></span></h2>
          <p class="h-meta" data-reveal><span>{pad(journalNotes.length)} drafts</span><a href="/notes/">全部记录 <span aria-hidden="true">↗</span></a></p>
        </header>
        <NoteList limit={3} />
      </div>
    </section>

    <section class="h-about tone-red" id="about" aria-labelledby="about-heading">
      <div class="page-width h-about-grid">
        <p class="h-no" data-reveal>(03) About</p>
        <div>
          <h2 id="about-heading" data-reveal="lines"><span class="line"><span>保持好奇，</span></span><span class="line"><span>慢慢做。</span></span></h2>
          <p data-reveal>{journal.about}</p>
          <p class="h-about-note" data-reveal>这个空间会随着项目一起生长。介绍文字为初稿，笔记目录暂为写作提纲占位，之后逐步换成真实的过程与记录。</p>
          <dl class="h-colophon" data-reveal>
            <div><dt>Issued by</dt><dd>TEISU<span>假想组织</span></dd></div>
            <div><dt>Kept by</dt><dd>{journal.author}</dd></div>
            <div class="h-colophon-art"><dt>Persona</dt><dd><img src="/media/persona/oil-720.webp" width="720" height="720" loading="lazy" decoding="async" alt="油画风格的人物插画：戴白色渔夫帽、系红色缎带的金色短发少女，背景左侧钴蓝、右侧朱红的厚涂笔触。" /><span>人物设定</span></dd></div>
          </dl>
          <a class="h-about-link text-link" href="/notes/" data-reveal>从一则笔记开始 <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="h-outro page-width" aria-label="站点导航">
      <div class="h-outro-row">
        <div class="h-outro-object" data-reveal="fade"><PistonGolem /></div>
        <ul class="h-outro-links" data-reveal>
          <li><a href="/work/">Work <span aria-hidden="true">↗</span></a></li>
          <li><a href="/notes/">Notes <span aria-hidden="true">↗</span></a></li>
          <li><a href="https://github.com/XJH-Jorhai">GitHub <span aria-hidden="true">↗</span></a></li>
        </ul>
      </div>
      <div class="h-outro-mark" data-reveal="fade"><Wordmark uid="outro" /></div>
    </section>
  </div>
  <script>
    import { initGate } from '../../lib/motion/gate';
    initGate();
  </script>
</PageShell>
