---
// Note rows. Colours come from the tone tokens (--rule, --dim, --mark), so the same list sits on
// paper (Notes) and on the night band (home).
import { journalNotes } from '../data/journal';
interface Props { expanded?: boolean; limit?: number }
const { expanded = false, limit = journalNotes.length } = Astro.props;
---
<div class="note-list">
  {journalNotes.slice(0,limit).map((note,index) => <article class="note-row" id={expanded ? note.id : undefined}>
    <span class="note-number">{String(index+1).padStart(2,'0')}</span>
    <div class="note-copy"><p class="note-category">{note.category}</p><h3>{expanded ? note.title : <a href={`/notes/#${note.id}`}>{note.title}<span aria-hidden="true"> ↗</span></a>}</h3><p class="note-summary">{note.summary}</p>
      {expanded && <details><summary>查看写作提纲 <span aria-hidden="true">＋</span></summary><p>{note.outline}</p></details>}
    </div>
    <span class="note-status">草稿占位</span>
  </article>)}
</div>
<style>
  .note-row {position:relative;border-top:1px solid var(--rule);padding:32px 0 36px;display:grid;grid-template-columns:80px 1fr auto;gap:24px;scroll-margin-top:32px;}
  .note-row:first-child {border-top-color:transparent;}
  .note-row::before {content:'';position:absolute;left:0;top:-1px;height:2px;width:0;background:var(--mark);transition:width .6s var(--ease);}
  .note-row:is(:hover,:focus-within)::before {width:100%;}
  .note-number {font:700 28px/1 var(--font-display);letter-spacing:-.03em;color:var(--mark);}
  .note-category,.note-status {font:11px/1.7 var(--font-mono);color:var(--dim);}
  .note-category {letter-spacing:.08em;margin-bottom:13px;}
  h3 {font:500 clamp(23px,2.5vw,36px)/1.4 var(--font-display);letter-spacing:-.03em;}
  h3 a {display:inline-block;} h3 a span {color:var(--mark);}
  .note-summary {max-width:650px;margin-top:14px;font-size:15px;line-height:1.9;color:var(--dim);}
  .note-status {border:1px solid var(--rule);padding:4px 9px;align-self:start;white-space:nowrap;}
  details {margin-top:24px;max-width:650px;font-size:14px;line-height:1.9;}
  summary {cursor:pointer;width:fit-content;padding:4px 0;font:500 14px var(--font-display);color:var(--color-accent);}
  summary span {margin-left:12px;color:var(--mark);} details[open] summary span {display:none;}
  details p {padding-top:14px;color:var(--dim);}
  @media(prefers-reduced-motion:reduce) {.note-row::before {transition:none;}}
  @media(max-width:650px) {.note-row {grid-template-columns:36px 1fr;gap:16px;padding-block:25px;} .note-number {font-size:22px;} .note-status {grid-column:2;grid-row:2;justify-self:start;} h3 {font-size:23px;} .note-summary {font-size:14px;}}
</style>
