---
// TEISU 字标（由用户提供的标志描出）。animated 时各字母可由 CSS 单独动画。
import brand from '../../data/brand.json';
interface Props { animated?: boolean }
const { animated = false } = Astro.props;
const L = brand.letters as Record<string,string>;
const id = animated ? 'wm-clip-a' : 'wm-clip';
---
<svg class:list={['wordmark', { 'is-animated': animated }]} viewBox="190 1250 1620 384" aria-hidden="true">
  <defs><clipPath id={id}><rect x="190" y="1250" width="1660" height="384" /></clipPath></defs>
  <g clip-path={`url(#${id})`}>
    <g class="l l-T" fill={brand.colors.navy} set:html={L.T} />
    <g class="l l-E l-E1" fill={brand.colors.navy} set:html={L.E1} />
    <g class="l l-E l-E2" fill={brand.colors.red} set:html={L.E2} />
    <g class="l l-E l-E3" fill={brand.colors.navy} set:html={L.E3} />
    <g class="l l-I" fill={brand.colors.navy} set:html={L.I} />
    <g class="l l-S" fill={brand.colors.navy} set:html={L.S} />
    <g class="l l-U" fill={brand.colors.navy} set:html={L.U} />
  </g>
</svg>
