---
interface Props { title: string; label: string }
const { title, label } = Astro.props;
---
<header class="index-heading">
  <div class="index-title-row"><h1>{title}</h1><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4l15 15M19 9v10H9" fill="none" stroke="currentColor" stroke-width="1.2" /></svg></div>
  <p class="index-label">{label}</p>
</header>
<style>
  .index-heading {padding-top:clamp(64px,8vw,140px);padding-bottom:clamp(48px,5.6vw,90px);}
  .index-title-row {display:flex;justify-content:space-between;align-items:stretch;gap:16px;}
  h1 {font-family:Arial,Helvetica,sans-serif;font-size:clamp(108px,22.4vw,376px);font-weight:400;letter-spacing:-.05em;line-height:.82;margin-left:-.015em;}
  svg {width:clamp(48px,6vw,96px);height:auto;align-self:flex-end;flex-shrink:0;color:var(--color-secondary);}
  .index-label {text-align:right;margin-top:34px;font:12px var(--font-mono);letter-spacing:.09em;color:var(--color-muted);}
  @media(max-width:760px) {.index-heading {padding-top:60px;padding-bottom:44px;} h1 {font-size:21vw;} svg {width:8vw;} .index-label {margin-top:25px;font-size:11px;letter-spacing:0;}}
</style>
