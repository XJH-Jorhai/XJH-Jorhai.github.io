---
// Title block of an index page: the same heavy uppercase display type as the home section heads.
interface Props { title: string; label: string; no: string; count: string }
const { title, label, no, count } = Astro.props;
---
<header class="index-heading">
  <p class="h-no">{no}</p>
  <div class="index-title-row">
    <h1 data-reveal="lines"><span class="line"><span>{title}</span></span></h1>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4l15 15M19 8v11H8" fill="none" stroke="currentColor" stroke-width="2.4" /></svg>
  </div>
  <p class="index-label"><span>{label}</span><span>{count}</span></p>
</header>
<style>
  .index-heading {padding-top:clamp(28px,4vw,72px);padding-bottom:clamp(48px,6vw,96px);color:var(--navy);}
  .index-title-row {display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin-top:clamp(14px,1.6vw,24px);padding-bottom:clamp(14px,1.8vw,28px);border-bottom:2px solid currentColor;}
  h1 {font:700 clamp(84px,19.5vw,330px)/.8 var(--font-display);letter-spacing:-.06em;text-transform:uppercase;margin-left:-.04em;}
  svg {width:clamp(40px,6.4vw,104px);height:auto;flex-shrink:0;color:var(--red);margin-bottom:.4%;}
  .index-label {display:flex;justify-content:space-between;gap:16px;margin-top:16px;font:12px var(--font-mono);letter-spacing:.12em;}
  .index-label span:last-child {color:var(--color-muted);}
  @media(max-width:650px) {.index-label {font-size:11px;letter-spacing:.06em;}}
</style>
