---
// Persona：以原创角色为视觉中心的一页：主视觉、三视图、表情、配色、服饰细节。
// 文案在 src/data/persona.ts，素材由 scripts/process-persona.mjs 生成，样式在 src/styles/persona.css，
// 交互在 src/lib/motion/persona.ts。没有 JS 时所有内容照常可读（三视图并排，六个表情全部列出）。
import PageShell from '../components/PageShell.astro';
import { persona } from '../data/persona';
import '@fontsource/barlow-condensed/800-italic.css';
import '@fontsource/barlow-condensed/900-italic.css';
import '../styles/persona.css';
const pad = (n: number) => String(n).padStart(2, '0');
const first = persona.moods[0]!;
---
<PageShell title="Persona" description="原创角色的人物设定：三视图、六种表情、配色与服饰细节。" blade={false}>
  <div class="persona" data-persona>
    <!-- 0 主视觉：色块碰撞，人物压在大字之上 -->
    <section class="p-hero" data-p-hero aria-labelledby="p-title">
      <div class="p-ground" aria-hidden="true">
        <i class="p-slab p-slab--red"></i>
        <i class="p-slab p-slab--navy"></i>
        <i class="p-slab p-slab--cream"></i>
        {[0, 1, 2, 3, 4].map(n => <i class={`p-streak p-streak--${n}`}></i>)}
      </div>
      <h1 id="p-title" class="p-word"><span class="visually-hidden">Persona</span>{[...'Persona'].map((char, i) => <span class="p-letter" aria-hidden="true" style={`--i:${i}`}>{char}</span>)}</h1>
      <img class="p-figure" src={persona.figure.src} width={persona.figure.width} height={persona.figure.height} alt={persona.figureAlt} fetchpriority="high" decoding="async" />
      <p class="p-tag"><span>Persona</span><span>人物设定</span></p>
      <div class="p-claim">
        <p class="p-claim-by"><span>Issued by</span>TEISU</p>
        <p class="p-claim-by"><span>Kept by</span>{persona.keeper}</p>
      </div>
      <a class="p-scroll" href="#turnaround">Scroll <span aria-hidden="true">↓</span></a>
    </section>

    <!-- 2 三视图 -->
    <section class="p-turn" id="turnaround" data-p-turn aria-labelledby="p-turn-h">
      <p class="p-backdrop" aria-hidden="true">Turnaround</p>
      <div class="page-width">
        <header class="p-head">
          <p class="p-no">(01)<span>Reference sheet</span></p>
          <h2 id="p-turn-h">三视图<span>Front / Side / Back</span></h2>
          <p class="p-head-note">原始服装</p>
        </header>
        <div class="p-turn-row">
          {persona.views.map((view, i) => <figure class="p-view" style={`--i:${i}`}>
            <div class="p-card"><img src={view.src} width={view.width} height={view.height} alt={view.alt} loading="lazy" decoding="async" /></div>
            <figcaption><span class="p-view-no">{pad(i + 1)}</span><strong>{view.zh}</strong><em>{view.en}</em></figcaption>
          </figure>)}
        </div>
      </div>
    </section>

    <!-- 3 表情：选一个表情，这一屏跟着换一套颜色和排法 -->
    <section class="p-mood" id="moods" data-p-mood data-mood={first.id} aria-labelledby="p-mood-h">
      <i class="p-mood-wipe" data-mood-wipe aria-hidden="true"></i>
      <div class="page-width">
        <header class="p-head">
          <p class="p-no">(02)<span>Expressions</span></p>
          <h2 id="p-mood-h">表情<span>Six moods</span></h2>
          <p class="p-head-note">表情示例（无帽）</p>
        </header>
        <div class="p-mood-stage">
          <p class="p-mood-word" data-mood-word aria-hidden="true">{first.zh}</p>
          <figure class="p-mood-face">
            <div class="p-card"><img data-mood-img src={first.src} width={first.width} height={first.height} alt={`表情：${first.zh}`} loading="lazy" decoding="async" /></div>
          </figure>
          <p class="p-mood-name" aria-live="polite"><span class="p-mood-count"><b data-mood-no>01</b> / {pad(persona.moods.length)}</span><strong data-mood-zh>{first.zh}</strong><em data-mood-en>{first.en}</em></p>
        </div>
        <div class="p-mood-picks" role="group" aria-label="选择表情">
          {persona.moods.map((mood, i) => <button type="button" class="p-pick" data-mood-pick={mood.id} data-zh={mood.zh} data-en={mood.en} data-src={mood.src} aria-pressed={i === 0 ? 'true' : 'false'} style={`--n:${i}`}>
            <img src={mood.src} width={mood.width} height={mood.height} alt="" loading="lazy" decoding="async" />
            <span class="p-pick-no">{pad(i + 1)}</span><strong>{mood.zh}</strong><em>{mood.en}</em>
          </button>)}
        </div>
      </div>
    </section>

    <!-- 3 配色：人物的颜色与页面的颜色 -->
    <section class="p-palette" aria-labelledby="p-palette-h">
      <div class="page-width">
        <header class="p-head">
          <p class="p-no">(03)<span>Colour</span></p>
          <h2 id="p-palette-h">配色<span>Character / Page</span></h2>
          <p class="p-head-note">色值取样自设定图色卡</p>
        </header>
      </div>
      <div class="p-swatches">
        <ul class="p-soft" aria-label="人物的颜色">
          {persona.palette.map((swatch, i) => <li style={`--c:${swatch.hex};--i:${i}`}><span class="p-swatch-role">{swatch.role}</span><strong>{swatch.name}</strong><code>{swatch.hex}</code></li>)}
        </ul>
        <ul class="p-loud" aria-label="页面的颜色">
          {persona.loud.map((swatch, i) => <li style={`--c:${swatch.hex};--i:${i}`}><strong>{swatch.name}</strong><code>{swatch.hex}</code></li>)}
        </ul>
      </div>
    </section>

    <!-- 5 服饰与细节 -->
    <section class="p-details" id="outfit" aria-labelledby="p-details-h">
      <p class="p-backdrop" aria-hidden="true">Details</p>
      <div class="page-width">
        <header class="p-head">
          <p class="p-no">(04)<span>Outfit</span></p>
          <h2 id="p-details-h">服饰与细节<span>Six pieces</span></h2>
        </header>
        <ul class="p-pieces">
          {persona.details.map((item, i) => <li class={`p-piece p-piece--${item.id}`} data-reveal>
            <div class="p-card"><img src={item.src} width={item.width} height={item.height} alt={item.zh} loading="lazy" decoding="async" /></div>
            <p><span class="p-view-no">{pad(i + 1)}</span><strong>{item.zh}</strong><em>{item.en}</em></p>
          </li>)}
        </ul>
      </div>
    </section>

    <!-- 5 收尾：背影和去别处 -->
    <section class="p-closing" aria-label="去别处">
      <div class="page-width">
        <figure class="p-back" data-reveal="fade">
          <div class="p-card"><img src={persona.back.src} width={persona.back.width} height={persona.back.height} alt="人物背面的发型：蜜金色短发的后脑勺。" loading="lazy" decoding="async" /></div>
          <figcaption>Back</figcaption>
        </figure>
        <nav class="p-out" aria-label="去别处">
          <a href="/" data-reveal>Blog <span aria-hidden="true">↗</span></a>
          <a href="/work/" data-reveal>Work <span aria-hidden="true">↗</span></a>
          <a href="/notes/" data-reveal>Notes <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </section>
  </div>
  <script>
    import { initPersona } from '../lib/motion/persona';
    initPersona();
  </script>
</PageShell>
