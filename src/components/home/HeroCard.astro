---
// C: 身份卡。像一张标签／名片，鼠标下有极轻的倾斜。
import { journalNotes } from '../../data/journal';
interface Props { workCount: number }
const { workCount } = Astro.props;
---
<section class="hero hero-card" data-hero aria-labelledby="hero-title">
  <div class="id-card" data-tilt>
    <div class="id-card-top">
      <svg class="emblem-mark" viewBox="0 0 120 120" aria-hidden="true"><circle cx="30" cy="60" r="9" /><circle cx="90" cy="26" r="9" /><circle cx="90" cy="94" r="9" /></svg>
      <span>PERSONAL FIELDNOTES</span>
    </div>
    <h1 id="hero-title" class="id-card-name">FIELDNOTES</h1>
    <dl class="id-card-fields">
      <div><dt>Focus</dt><dd>Research · Making · Observation</dd></div>
      <div><dt>Work</dt><dd>{String(workCount).padStart(2,'0')}</dd></div>
      <div><dt>Notes</dt><dd>{String(journalNotes.length).padStart(2,'0')} · 草稿</dd></div>
      <div><dt>GitHub</dt><dd><a href="https://github.com/XJH-Jorhai">@XJH-Jorhai</a></dd></div>
    </dl>
    <p class="id-card-foot" aria-hidden="true"><span>∴</span><span>FN—{String(workCount).padStart(3,'0')}</span></p>
  </div>
  <a class="hero-scroll" href="#intro">Scroll <span aria-hidden="true">↓</span></a>
</section>
