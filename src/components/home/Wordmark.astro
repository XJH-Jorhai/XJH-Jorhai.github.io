---
// TEISU 字标（由用户提供的标志描出）。同一页出现多次时用 uid 区分裁切路径。
import brand from '../../data/brand.json';
interface Props { uid?: string; tone?: 'brand' | 'light' }
const { uid = 'a', tone = 'brand' } = Astro.props;
const ink = tone === 'light' ? '#F6F1E7' : brand.colors.navy;
const L = brand.letters as Record<string,string>;
const id = `wm-clip-${uid}`;
---
<svg class="wordmark" viewBox="190 1250 1620 384" aria-hidden="true">
  <defs><clipPath id={id}><rect x="190" y="1250" width="1660" height="384" /></clipPath></defs>
  <g clip-path={`url(#${id})`}>
    <g class="l l-T" fill={ink} set:html={L.T} />
    <g class="l l-E l-E1" fill={ink} set:html={L.E1} />
    <g class="l l-E l-E2" fill={brand.colors.red} set:html={L.E2} />
    <g class="l l-E l-E3" fill={ink} set:html={L.E3} />
    <g class="l l-I" fill={ink} set:html={L.I} />
    <g class="l l-S" fill={ink} set:html={L.S} />
    <g class="l l-U" fill={ink} set:html={L.U} />
  </g>
</svg>
