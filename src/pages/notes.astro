---
import PageShell from '../components/PageShell.astro';
import IndexHeading from '../components/IndexHeading.astro';
import NoteList from '../components/NoteList.astro';
import ClosingBand from '../components/ClosingBand.astro';
import { journalNotes } from '../data/journal';
const count = `${String(journalNotes.length).padStart(2,'0')} DRAFTS`;
---
<PageShell title="Notes" description="研究、制作与观察中的过程笔记。" sheen>
  <div class="page-width">
    <IndexHeading title="NOTES" no="(02)" label="THOUGHTS IN PROGRESS / INDEX" count={count} />
    <section class="statement" aria-labelledby="notes-intro">
      <p class="h-no" data-reveal>OFF THE WORKBENCH<br />工作台之外</p>
      <div>
        <h2 id="notes-intro" data-reveal="lines"><span class="line"><span>让过程有迹可循。</span></span></h2>
        <p data-reveal>作品之外，还有尝试、疑问和偶然的发现。这里留给研究中的思考、制作时的细节，以及那些还没有标准答案的问题。</p>
        <p class="statement-note" data-reveal>以下是准备展开的写作方向，均为草稿占位；展开条目可以查看提纲。</p>
      </div>
    </section>
    <section class="list-section" aria-labelledby="notes-list">
      <div class="list-head"><h2 id="notes-list">WRITING DESK / 写作目录</h2><span class="h-no">OUTLINES / 提纲</span></div>
      <NoteList expanded />
    </section>
  </div>
  <ClosingBand kicker="FROM NOTES TO OBJECTS" title="Work" href="/work/" note="有些想法，后来变成了作品。" />
</PageShell>
