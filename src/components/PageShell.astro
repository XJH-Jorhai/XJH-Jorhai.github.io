---
// The one shell every page shares: paper ground, TEISU mark top-left, corner blade, footer navigation.
import { site } from '../config/site';
import { palette } from '../data/palette';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import '../styles/tokens.css';
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  language?: string;
  /** Pointer light trail (index pages with a cover gallery). */
  sheen?: boolean;
  noindex?: boolean;
  /** The home page has its own opening and corner blocks instead of the mark and blade. */
  home?: boolean;
  /** Pages with their own full-bleed top (Persona) keep the mark but drop the corner blade. */
  blade?: boolean;
}
const { title, description = site.description, language = 'zh-CN', sheen = false, noindex = false, home = false, blade = true } = Astro.props;
const pathname = Astro.url.pathname;
const colors = Object.entries(palette).filter(([role]) => role !== 'name').map(([role, value]) => `--color-${role}:${value}`).join(';');
---
<!doctype html>
<html lang={language} style={colors}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={palette.base} />
    <title>{title ? `${title} · ${site.name}` : site.name}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="paper">
    {sheen && <div data-mineral-sheen aria-hidden="true" hidden></div>}
    <a class="skip-link" href="#main">跳至正文</a>
    <slot name="overlay" />
    {!home && blade && <div class="page-blade" aria-hidden="true"></div>}
    {!home && <a class="home-mark" href="/" aria-label="TEISU FIELDNOTES，回到首页"><img src="/media/brand/teisu-mark.svg" width="30" height="30" alt="" /></a>}
    <main id="main"><slot /></main>
    <footer class="site-footer page-width">
      <a class="footer-brand" href="/"><img src="/media/brand/teisu-mark.svg" width="20" height="20" alt="" />TEISU<span>{site.name}</span></a>
      <nav class="footer-nav" aria-label="主导航">
        <a href="/" aria-current={pathname === '/' ? 'page' : undefined}>Blog</a>
        <a href="/work/" aria-current={pathname.startsWith('/work') || pathname.startsWith('/projects') ? 'page' : undefined}>Work</a>
        <a href="/notes/" aria-current={pathname.startsWith('/notes') ? 'page' : undefined}>Notes</a>
        <a href="/persona/" aria-current={pathname.startsWith('/persona') ? 'page' : undefined}>Persona</a>
        <a href="/#about">About</a>
      </nav>
      <a class="footer-top" href="#main">Back to top <span aria-hidden="true">↑</span></a>
    </footer>
    <script>
      import { initMotion } from '../lib/motion';
      import { initReveal } from '../lib/motion/reveal';
      initReveal();
      initMotion();
    </script>
  </body>
</html>
