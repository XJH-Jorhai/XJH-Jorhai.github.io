---
import PageShell from './PageShell.astro';
import IndexHeading from './IndexHeading.astro';
import WorkGallery from './WorkGallery.astro';
import ClosingBand from './ClosingBand.astro';
import { getCollection } from 'astro:content';
const count = (await getCollection('projects')).length;
---
<PageShell title="Work" description="Selected work in remote sensing and analog computing." sheen>
  <div class="work-index page-width">
    <IndexHeading title="WORK" no="(01)" label="SELECTED WORK / INDEX" count={`${String(count).padStart(2,'0')} PROJECTS`} />
    <WorkGallery />
  </div>
  <ClosingBand kicker="OFF THE WORKBENCH" title="Notes" href="/notes/" note="工作台之外：研究中的思考、制作时的细节，以及还没有标准答案的问题。" />
</PageShell>
<style>
.work-index {padding-bottom:var(--space-section);}
</style>
