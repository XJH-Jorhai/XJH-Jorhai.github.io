---
import { getCollection } from 'astro:content';
import ProjectVisual from './ProjectVisual.astro';
import { assetsFor } from '../data/projects';
import { workIndexCopy } from '../data/work-index';
const projects = (await getCollection('projects')).sort((a,b) => a.id.localeCompare(b.id));
---
    <section class:list={['work-gallery',{'work-gallery--single':projects.length===1}]} aria-label="Selected work">
      {projects.map(({id}) => <article class="work-item">
        <a class="work-cover" href={`/projects/${id}/`} aria-labelledby={`${id}-title`}>
          <ProjectVisual assets={assetsFor(`${id}-cover`)} mode="home" alt={workIndexCopy[id]!.alt} caption="" sizes="(max-width:488px) calc(100vw - 44px), (max-width:760px) 91vw, (min-width:1584px) 696px, 44vw" showCaption={false} previewOnHover />
        </a>
        <div class="work-caption"><p class="work-tags">{workIndexCopy[id]!.tags}</p><h2 id={`${id}-title`}><a class="work-title-link" href={`/projects/${id}/`}><span class="title-arrow" aria-hidden="true">→</span><span class="title-label">{workIndexCopy[id]!.title}</span></a></h2></div>
      </article>)}
    </section>

<style>
  .work-gallery { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:80px clamp(24px,3vw,56px); align-items:start; }
  .work-gallery--single {grid-template-columns:1fr;}
  .work-item {min-width:0;}
  .work-cover {display:block;}
  .work-cover :global(.project-visual) {width:100%;}
  .work-cover :global(.visual-frame) {width:100%;}
  .work-caption {padding-top:23px;}
  .work-tags {font-size:13px;line-height:1.6;color:var(--color-muted);margin-bottom:12px;letter-spacing:0;text-transform:none;}
  h2 {font-size:clamp(23px,2.25vw,36px);font-weight:400;line-height:1.45;letter-spacing:-.035em;}
  .work-title-link {display:block;position:relative;white-space:nowrap;--arrow-space:1.2em;}
  .title-label {display:inline-block;transition:transform .3s cubic-bezier(.22,.61,.36,1);}
  .title-arrow {position:absolute;left:0;opacity:0;transform:translateX(-.5em);transition:transform .3s cubic-bezier(.22,.61,.36,1),opacity .2s ease;}
  .work-title-link:focus-visible .title-label {transform:translateX(var(--arrow-space));}
  .work-title-link:focus-visible .title-arrow {opacity:1;transform:translateX(0);}
  @media(hover:hover) { .work-title-link:hover .title-label {transform:translateX(var(--arrow-space));} .work-title-link:hover .title-arrow {opacity:1;transform:translateX(0);} }
  @media(prefers-reduced-motion:reduce) {.title-label,.title-arrow {transition:none;}}
  @media(max-width:760px) {
    .work-gallery {grid-template-columns:1fr;gap:55px;}
    .work-caption {padding-top:18px;}
    .work-tags {margin-bottom:8px;font-size:12px;}
    .work-title-link {white-space:normal;}
    .title-label {max-width:calc(100% - var(--arrow-space));}
    h2 {font-size:clamp(20px,5.6vw,25px);}
  }
</style>
