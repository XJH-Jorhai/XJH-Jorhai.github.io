---
import PageShell from '../PageShell.astro';
import WorkGallery from '../WorkGallery.astro';
import NoteList from '../NoteList.astro';
import PistonGolem from '../PistonGolem.astro';
import Gate from './Gate.astro';
import Wordmark from './Wordmark.astro';
import StrokeWord from './StrokeWord.astro';
import { journal, journalNotes } from '../../data/journal';
import { persona } from '../../data/persona';
import '@fontsource/barlow-condensed/900-italic.css';
import { getCollection } from 'astro:content';
import '../../styles/home.css';
const workCount = (await getCollection('projects')).length;
const pad = (n: number) => String(n).padStart(2, '0');
---
<PageShell title="Blog" description={journal.description} sheen home>
  <Gate slot="overlay" />
  <div class="home" data-home>
    <section class="hero page" id="cover" data-page tabindex="-1" aria-labelledby="hero-title">
      <div class="hero-grid">
        <h1 id="hero-title" class="hero-title"><span class="visually-hidden">FIELDNOTES</span><StrokeWord text="FIELD" id="a" /><StrokeWord text="NOTES" id="b" delay={.2} /></h1>
        <div class="hero-imprint">
          <p class="h-no" data-h style="--d:.5s">Issued by</p>
          <div data-h style="--d:.58s"><Wordmark uid="hero" /></div>
          <p class="hero-lede stair">{journal.lede.map((line, i) => <span data-h style={`--step:${i};--d:${(.68 + i * .08).toFixed(2)}s`}>{line}</span>)}</p>
        </div>
        <p class="hero-byline" data-h style="--d:.7s"><span class="h-no">Kept by</span><span class="hero-handle">{journal.author}</span></p>
        <p class="hero-line"><span class="hero-line-flat" data-h style="--d:.8s">{journal.introduction}</span>{journal.motto.map((column, c) => <span class="hero-col" aria-hidden="true">{[...column].map((char, i) => <i style={`--c:${c * 8 + i}`}>{char}</i>)}</span>)}</p>
        <div class="hero-foot" aria-hidden="true"></div>
      </div>
    </section>

    <!-- Every page after the cover is a poster on one skeleton (home.css, "Poster skeleton"): one giant
         word on the bottom edge running off it, which is also the way in (WORK opens /work/ and so on),
         one 45° slab painted with the oil portrait's brushwork, and a pane of red glass laid across the
         slab's edge, over the painting on one side and the paper and the word on the other. Where the word crosses the slab it changes colour (it is set twice, the
         second copy clipped to the slab). Headings are for screen readers; the poster carries no small
         print beyond what must be there (the draft stamp). -->
    <section class="h-work page poster" id="work" data-page tabindex="-1" aria-labelledby="work-heading">
      <div class="pg-ground" aria-hidden="true"><i class="pg-slab"></i></div>
      <div class="pg-word">
        <span class="pg-word-layer pg-ink"><a href="/work/" aria-label={`全部作品（${pad(workCount)}）`}>Work</a></span>
        <span class="pg-word-layer pg-cut" aria-hidden="true"><span>Work</span></span>
      </div>
      <i class="pg-pane glass" aria-hidden="true"></i>
      <div class="page-width pg-body">
        <h2 id="work-heading" class="visually-hidden">Selected work 作品</h2>
        <WorkGallery variant="poster" />
      </div>
    </section>

    <section class="h-notes tone-night page poster" id="notes" data-page tabindex="-1" aria-labelledby="notes-heading">
      <div class="pg-ground" aria-hidden="true"><i class="pg-slab"></i></div>
      <div class="pg-word">
        <span class="pg-word-layer pg-ink"><a href="/notes/" aria-label={`全部笔记（${pad(journalNotes.length)}）`}>Notes</a></span>
        <span class="pg-word-layer pg-cut" aria-hidden="true"><span>Notes</span></span>
      </div>
      <i class="pg-pane glass" aria-hidden="true"></i>
      <div class="page-width pg-body">
        <h2 id="notes-heading" class="visually-hidden">Notes &amp; observations 笔记</h2>
        <p class="pg-stamp" data-enter style="--k:2"><span>Drafts</span>草稿</p>
        <NoteList limit={3} />
      </div>
    </section>

    <!-- (03) Persona: a magazine cover. PERSONA is broken in two and set behind her: PER at the top-left
         beside her head, SONA running off the bottom edge on the right with her skirt over the S, so the
         word frames her along the diagonal instead of crossing her; the word opens /persona/. The slab,
         the red glass blade and her red shadow are painted with the brushwork of her oil portrait. On a fine pointer the layers move at different depths, her
         eyes follow the pointer and rubbing her head makes hearts pop up (persona-stage.ts). -->
    <section class="h-persona page" id="persona" data-page tabindex="-1" aria-labelledby="persona-heading">
      <div class="hp-stage" data-hp-stage>
        <div class="hp-ground" aria-hidden="true"><i class="hp-slab"></i><i class="hp-blade"></i></div>
        <div class="hp-word">{['hp-ink', 'hp-cut'].map(layer => <span class:list={['hp-word-layer', layer]} aria-hidden={layer === 'hp-cut' ? 'true' : undefined}>{['PER', 'SONA'].map((part, p) => layer === 'hp-ink'
          ? <a class:list={['hp-part', `hp-part-${p ? 'b' : 'a'}`]} href="/persona/" aria-label={p ? undefined : '人物设定'} aria-hidden={p ? 'true' : undefined} tabindex={p ? -1 : undefined}>{[...part].map((char, i) => <span class="hp-letter" style={`--i:${p * 3 + i}`}>{char}</span>)}</a>
          : <span class:list={['hp-part', `hp-part-${p ? 'b' : 'a'}`]}>{[...part].map((char, i) => <span class="hp-letter" style={`--i:${p * 3 + i}`}>{char}</span>)}</span>)}</span>)}</div>
        <div class="hp-figure-box">
          <span class="hp-shadow" aria-hidden="true" style={`--mask:url(${persona.figure.src})`}></span>
          <div class="hp-figure-body">
            <img class="hp-figure" src={persona.figure.src} width={persona.figure.width} height={persona.figure.height} alt={persona.figureAlt} loading="eager" decoding="async" />
            {persona.eyes.map(eye => <span class="hp-eye" aria-hidden="true" data-hp-eye data-white={eye.white} data-iris={eye.iris} style={eye.style}></span>)}
            <span class="hp-head" aria-hidden="true" data-hp-head></span>
          </div>
          <span class="hp-hearts" aria-hidden="true" data-hp-hearts></span>
        </div>
      </div>
      <h2 id="persona-heading" class="visually-hidden">Persona 人物设定</h2>
    </section>

    <!-- (04) About: who keeps this, the golem, and the issuing mark as the giant word; the footer is the
         way out. A painted slab with a glass blade in the top-right corner answers the cover's corner
         blocks. -->
    <section class="h-outro page poster" id="about" data-alias="end" data-page tabindex="-1" aria-labelledby="about-heading">
      <div class="pg-ground" aria-hidden="true"><i class="pg-slab"></i></div>
      <i class="pg-pane glass" aria-hidden="true"></i>
      <div class="page-width pg-body">
        <h2 id="about-heading" class="visually-hidden">About 关于</h2>
        <div class="h-outro-row">
          <div class="h-about">
            <p class="h-about-title"><span data-enter="cut" style="--k:1">保持好奇，</span><span data-enter="cut" style="--k:2.4">慢慢做。</span></p>
            <p class="h-about-text" data-lines style="--k:4">{journal.about}</p>
            <p class="pg-stamp" data-enter style="--k:6"><span>Draft</span>初稿</p>
          </div>
        </div>
        <div class="h-outro-mark">
          <div data-enter="cut" style="--k:4"><Wordmark uid="outro" /></div>
          <div class="h-outro-object" data-enter="fade" style="--k:6"><PistonGolem /></div>
        </div>
      </div>
    </section>
  </div>
  <!-- Paged home (pager.ts): a tick per page, and the canvas the page transition is drawn on (sweep.ts). -->
  <nav class="pager" data-pager aria-label="分屏导航" hidden>
    <a href="#cover"><span>Cover</span></a>
    <a href="#work"><span>Work</span></a>
    <a href="#notes"><span>Notes</span></a>
    <a href="#persona"><span>Persona</span></a>
    <a href="#about"><span>About</span></a>
  </nav>
  <canvas class="wipe" data-wipe aria-hidden="true"></canvas>
  <script>
    import { initGate } from '../../lib/motion/gate';
    import { initPager } from '../../lib/motion/pager';
    import { initPersonaStage } from '../../lib/motion/persona-stage';
    initPersonaStage();
    initPager();
    initGate();
  </script>
</PageShell>
