{
  "name": "blog-style-prototype",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=9.6.5"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1",
    "images": "node scripts/process-image.mjs && node scripts/prepare-depth.mjs && node scripts/process-project-02.mjs",
    "check": "node scripts/astro.mjs check && node scripts/validate-content.mjs",
    "build": "node scripts/astro.mjs build",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1 --port 4321",
    "test:browser": "node scripts/verify-parallax-refinement.mjs",
    "test:webgl": "node scripts/verify-parallax-refinement.mjs",
    "check:sources": "node scripts/validate-content.mjs --sources",
    "test:site": "node scripts/verify-site.mjs",
    "test:piston": "node scripts/verify-piston-impact.mjs"
  },
  "dependencies": {
    "astro": "7.4.2",
    "motion": "14.6.0",
    "three": "^0.186.1",
    "three-fluid-fx": "0.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.64.1",
    "@types/three": "^0.186.0",
    "sharp": "0.35.5",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "@types/three": "$@types/three"
  }
}
